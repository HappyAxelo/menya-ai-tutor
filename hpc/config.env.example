# Menya AI — HPC model server settings. Copy to config.env and fill in.
# config.env holds secrets: keep it private (chmod 600). Never commit it.

# --- Your cluster (ask your HPC support team for these) ---
SLURM_ACCOUNT=""            # e.g. "my-project"   (leave empty if your cluster has no accounts)
SLURM_PARTITION="gpu"       # GPU partition name
SLURM_GRES="gpu:1"          # e.g. "gpu:a100:1" to ask for a specific GPU type
SLURM_TIME="24:00:00"       # longest time a job may run on your partition
SLURM_MEM="64G"
SLURM_CPUS="8"
MODULES=""                  # modules to load first, e.g. "cuda/12.4 python/3.11" (leave empty if not needed)
WORK_DIR="$HOME/menya-hpc"  # where the venv, model weights and logs live (use a scratch/work area if home is small)

# --- The model ---
# openai/gpt-oss-120b : best tutoring quality, needs one 80 GB GPU (A100 80GB / H100)
# openai/gpt-oss-20b  : fits a 24-40 GB GPU; check quality with the evaluation script first
MODEL="openai/gpt-oss-120b"
MAX_MODEL_LEN="16384"
VLLM_EXTRA_ARGS=""          # anything else for "vllm serve", e.g. "--tensor-parallel-size 2"

# --- Connection to Menya (the same values go into Supabase secrets) ---
MENYA_API_URL="https://tgrihnmngbamxxjnedlc.supabase.co/functions/v1/api"
HPC_REGISTER_SECRET=""      # 32+ random characters; Supabase secret HPC_REGISTER_SECRET
VLLM_API_KEY=""             # 32+ random characters; Supabase secret LOCAL_LLM_API_KEY
AUTO_RESUBMIT="1"           # 1 = queue the next job automatically so the model keeps running
LOCAL_LLM_JSON_MODE="json_schema"  # must match the Supabase secret LOCAL_LLM_JSON_MODE (json_object if the self-test fails)
