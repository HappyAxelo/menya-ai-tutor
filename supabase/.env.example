# Edge Function secrets. Set in production with:
#   supabase secrets set --env-file supabase/.env
# Never commit the real file (supabase/.env is git-ignored).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Public URL of the web app (invite and checkout links point here)
APP_URL=https://menyaneza.com
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=https://menyaneza.com,https://www.menyaneza.com,https://happyaxelo.github.io,http://localhost:5173

# Model providers: a provider with no key is skipped by the router
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional self-hosted OpenAI-compatible server (vLLM, Ollama, LM Studio)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# json_schema_strict | json_schema | json_object (older Ollama versions need json_object)
LOCAL_LLM_JSON_MODE=json_schema

# Academic research (docs/RESEARCH.md). All optional and free. Without them OpenAlex, Crossref, DOAJ, Europe PMC, PubMed
# and arXiv still work on shared public limits. Keys stay here, never in the website or the database.
RESEARCH_CONTACT_EMAIL=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
CORE_API_KEY=

# Billing: leave BILLING_PROVIDER empty until a live provider adapter exists.
# "test" accepts HMAC-signed test events only (scripts/send-test-webhook.mjs).
BILLING_PROVIDER=
BILLING_TEST_WEBHOOK_SECRET=
